<Window x:Class="Calculator_Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="iOS Calculator by Kusz0"
        Height="590" Width="395"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0B0B">


    <Grid>
    <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        
            <ColumnDefinition Width="20px"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DisplayScreen"
                   Grid.Row="0" Grid.ColumnSpan="4"
                   Text="{Binding Result}"
                   Foreground="White"
                   FontSize="72"
                   FontWeight="Light"
                   TextAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,10,10"
                   />

        <Button Grid.Row="1" Grid.Column="0" Content="AC" Style="{StaticResource FunctionButton}" FontWeight="Normal"/>
        <Button Grid.Row="1" Grid.Column="1" Content="+/−" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="2" Content="%" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="3" Content="×" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="3" Grid.Column="0" Content="4" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="1" Content="5" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="2" Content="6" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="3" Content="−" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="4" Grid.Column="0" Content="1" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="1" Content="2" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="2" Content="3" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                Content="0"
                HorizontalAlignment="Left"
                Style="{StaticResource RoundButton}"
                Width="168" Height="80">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="40"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"/>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Grid.Row="5" Grid.Column="2" Content="." Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="5" Grid.Column="3" Content="=" Style="{StaticResource OperatorButton}"/>

        <Button x:Name="expandBtn" Click="expandBtn_Click" Content="+" Grid.Row="1" Grid.Column="4" Grid.RowSpan="5" Style="{StaticResource ExpandBtn}"/>

        <!--= niewidoczna sekcja -->
        <Grid x:Name="AdvancedModeSection" Grid.Column="5" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Button Grid.Row="0" Grid.Column="0" Content="(" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="0" Grid.Column="1" Content=")" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="1" Grid.Column="0" Content="x^2" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="x^n" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="2" Grid.Column="0" Content="√x" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="n^√x" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="x!" Style="{StaticResource RoundButton}"/>
        </Grid>

        

    </Grid>
</Window>
