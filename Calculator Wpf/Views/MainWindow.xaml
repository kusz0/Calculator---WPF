<Window x:Class="Calculator_Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="iOS Calculator by Kusz0"
        Height="620" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0B0B">

    <!-- STYLE -->
    <Window.Resources>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ellipse"
                                     Fill="{TemplateBinding Background}"
                                     Width="{TemplateBinding Width}"
                                     Height="{TemplateBinding Height}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ellipse" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Background" Value="#FFFE9500"/>
        </Style>

        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Background" Value="#A5A5A5"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
    <!-- Colums -->
    <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Screen -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 5 -->
        </Grid.RowDefinitions>

        <!-- Screenm -->
        <TextBlock x:Name="DisplayScreen"
                   Grid.Row="0" Grid.ColumnSpan="4"
                   Text="{Binding Result}"
                   Foreground="White"
                   FontSize="72"
                   FontWeight="Light"
                   TextAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,10,10"/>

        <!-- Row 1 -->
        <Button Grid.Row="1" Grid.Column="0" Content="AC" Style="{StaticResource FunctionButton}" FontWeight="Normal"/>
        <Button Grid.Row="1" Grid.Column="1" Content="+/−" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="2" Content="%" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Style="{StaticResource OperatorButton}"/>

        <!-- Row 2 -->
        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="3" Content="×" Style="{StaticResource OperatorButton}"/>

        <!-- Row 3 -->
        <Button Grid.Row="3" Grid.Column="0" Content="4" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="1" Content="5" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="2" Content="6" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="3" Content="−" Style="{StaticResource OperatorButton}"/>

        <!-- Row 4 -->
        <Button Grid.Row="4" Grid.Column="0" Content="1" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="1" Content="2" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="2" Content="3" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Style="{StaticResource OperatorButton}"/>

        <!-- Row 5 -->
        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                Content="0"
                HorizontalAlignment="Left"
                Style="{StaticResource RoundButton}"
                Width="168" Height="80">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="40"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"/>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Grid.Row="5" Grid.Column="2" Content="." Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="5" Grid.Column="3" Content="=" Style="{StaticResource OperatorButton}"/>

    </Grid>
</Window>
