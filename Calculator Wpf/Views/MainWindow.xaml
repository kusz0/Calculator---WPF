<Window x:Class="Calculator_Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="iOS Calculator by Kusz0"
        Height="590" Width="auto"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0B0B">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />

            <ColumnDefinition Width="20px"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.ColumnSpan="6" 
            Grid.Row="0"
            HorizontalScrollBarVisibility="Auto" 
         VerticalScrollBarVisibility="Disabled"
         HorizontalAlignment="Right" 
         VerticalAlignment="Bottom" x:Name="ResultScroll"
                      MaxWidth="390">

            <Label x:Name="ResultLabel" 
                   Style="{StaticResource ResultLabel}"
                   Content="{Binding DisplayText}"/>
        </ScrollViewer>

        <Button Grid.Row="1" Grid.Column="0" Content="AC"  Command="{Binding ClearCommand}" Style="{StaticResource FunctionButton}" FontWeight="Normal"/>
        <Button Grid.Row="1" Grid.Column="1" Content="+/−" Command="{Binding SignCommand}" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="2" Content="%" Command="{Binding PercentCommand}" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Command="{Binding InputCommand}" CommandParameter="÷" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding InputCommand}" CommandParameter="7" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8"  Command="{Binding InputCommand}" CommandParameter="8" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding InputCommand}" CommandParameter="9" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="2" Grid.Column="3" Content="×" Command="{Binding InputCommand}" CommandParameter="×" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="3" Grid.Column="0" Content="4" Command="{Binding InputCommand}" CommandParameter="4" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="1" Content="5" Command="{Binding InputCommand}" CommandParameter="5" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="2" Content="6" Command="{Binding InputCommand}" CommandParameter="6" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="3" Grid.Column="3" Content="−" Command="{Binding InputCommand}" CommandParameter="−" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="4" Grid.Column="0" Content="1" Command="{Binding InputCommand}" CommandParameter="1" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="1" Content="2" Command="{Binding InputCommand}" CommandParameter="2" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="2" Content="3" Command="{Binding InputCommand}" CommandParameter="3" Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Command="{Binding InputCommand}" CommandParameter="+" Style="{StaticResource OperatorButton}"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                Content="0"
                Command="{Binding InputCommand}" CommandParameter="0"
                HorizontalAlignment="Left"
                Style="{StaticResource RoundButton}"
                Width="168" Height="80">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="40"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"/>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Grid.Row="5" Grid.Column="2" Content="." Command="{Binding InputCommand}" CommandParameter="." Style="{StaticResource RoundButton}"/>
        <Button Grid.Row="5" Grid.Column="3" Content="=" Command="{Binding CalculateCommand}" Style="{StaticResource OperatorButton}"/>


        <!--= unvisuble section-->
        <Grid x:Name="AdvancedModeSection" Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <Button Grid.Row="0" Grid.Column="0" Content="(" Command="{Binding InputCommand}" CommandParameter="(" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="0" Grid.Column="1" Content=")" Command="{Binding InputCommand}" CommandParameter=")" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="1" Grid.Column="0" Content="x^2" Command="{Binding InputCommand}" CommandParameter="^2" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="x^n" Command="{Binding InputCommand}" CommandParameter="^" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="2" Grid.Column="0" Content="√x" Command="{Binding InputCommand}" CommandParameter="sqrt(" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="n^√x" Command="{Binding InputCommand}" CommandParameter="^(1/" Style="{StaticResource RoundButton}"/>

            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="x!" Style="{StaticResource RoundButton}"/>
            <Button Grid.Row="3" Grid.ColumnSpan="2"
            Content="x!"
            Command="{Binding InputCommand}" CommandParameter="!"
            HorizontalAlignment="Left"
            Style="{StaticResource RoundButton}"
            Width="168" Height="80">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                             CornerRadius="40"
                             Width="{TemplateBinding Width}"
                             Height="{TemplateBinding Height}"/>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>


        <Button x:Name="expandBtn" Click="ExpandBtn_Click" Content="+" Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2" Width="30" Style="{StaticResource ExpandBtn}"/>

    </Grid>
</Window>
